# AI provider key used by Gemini service in browser mode (leave blank to force simulation fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Feature flags
VITE_ENABLE_BACKEND_AUTH=false
VITE_ENABLE_BACKEND_DATA=false
VITE_ENABLE_LIVE_INTEGRATIONS=false
VITE_ENABLE_EXPERIMENTAL=false
VITE_DISABLE_AI_UI=false

# Owner identity for overseer role mapping
VITE_OVERSEER_EMAIL=owner@one82.io

# API base URLs (set empty on Vercel for same-origin /api)
VITE_AUTH_API_BASE=http://localhost:3000
VITE_DATA_API_BASE=http://localhost:3000

# Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase table names (override only if your deployment uses custom table naming)
ONE82_SUPABASE_STATE_TABLE=one82_state
ONE82_SUPABASE_LOGIN_USERS_TABLE=one82_login_users
ONE82_SUPABASE_LOGIN_SESSIONS_TABLE=one82_login_sessions
ONE82_SUPABASE_TENANTS_TABLE=one82_tenants
ONE82_SUPABASE_MERCHANTS_TABLE=one82_merchants
ONE82_SUPABASE_TEAM_MEMBERS_TABLE=one82_team_members
ONE82_SUPABASE_PROCESSOR_TRANSACTIONS_TABLE=one82_processor_transactions
ONE82_SUPABASE_IMPORT_JOBS_TABLE=one82_import_jobs
ONE82_SUPABASE_SYNC_RUNS_TABLE=one82_sync_runs
ONE82_SUPABASE_EVENTS_TABLE=one82_events